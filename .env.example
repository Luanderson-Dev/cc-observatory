# cc-observatory: optional settings for the compose stack.
#
# Copying this file to .env is optional: every variable below already has the same
# default in the compose files. .env is never committed (it is in .gitignore).
# Every published port binds to 127.0.0.1 only.

# Host port of the collector's OTLP/gRPC receiver.
CCOBS_OTLP_GRPC_PORT=4317
# Host port of the collector's OTLP/HTTP receiver.
CCOBS_OTLP_HTTP_PORT=4318

# Reserved for the app (milestone 2); not used yet.
# CCOBS_APP_PORT=4300
