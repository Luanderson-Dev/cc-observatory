# cc-observatory: optional settings for the compose stack.
#
# Copying this file to .env is optional: every variable below already has the same
# default in the compose files. .env is never committed (it is in .gitignore).
# Every published port binds to 127.0.0.1 only.

# Host port of the collector's OTLP/gRPC receiver.
CCOBS_OTLP_GRPC_PORT=4317
# Host port of the collector's OTLP/HTTP receiver.
CCOBS_OTLP_HTTP_PORT=4318
# The host label stored on every metric, event and trace: letters, digits, ".", "_" and
# "-". Set it to the machine's hostname only if you want the hostname stored.
CCOBS_HOST_LABEL=local

# Host port of Grafana. Open it at http://localhost:<port> (http://localhost:4330 by
# default): Grafana redirects any other host name, 127.0.0.1 included, to localhost.
# The app's links to Grafana follow this port.
CCOBS_GRAFANA_PORT=4330

# Host port of Prometheus's HTTP API, published only by compose.debug.yaml.
CCOBS_PROMETHEUS_PORT=4390
# How long Prometheus keeps metrics, in Prometheus's own units: y, w, d, h, m, s or ms
# (90d is 90 days).
CCOBS_PROMETHEUS_RETENTION=90d

# Host port of Loki's HTTP API, published only by compose.debug.yaml.
CCOBS_LOKI_PORT=4310
# How long Loki keeps events, as a multiple of 24h, Loki's index period (720h is 30
# days).
CCOBS_LOKI_RETENTION=720h

# Host port of Tempo's HTTP API, published only by compose.debug.yaml. Tempo runs only
# with the traces profile (docker compose --profile traces up -d).
CCOBS_TEMPO_PORT=4320
# How long Tempo keeps traces, as a Go duration, hours at most (168h is 7 days). Tempo
# refuses days, such as 7d, and does not start.
CCOBS_TEMPO_RETENTION=168h

# Host port of the app: its web pages and API, and the hook endpoint Claude Code posts
# to (http://127.0.0.1:4300 by default).
CCOBS_APP_PORT=4300
# Host port of the app's metrics listener (/metrics), published only by
# compose.debug.yaml; Prometheus scrapes it inside the stack.
CCOBS_APP_METRICS_PORT=4301
# How long the app keeps sessions, agents, blocks and hook events after a session's last
# event, in Prometheus's units (90d is 90 days). At least 1d, and never shorter than
# CCOBS_SESSION_STALE_AFTER.
CCOBS_APP_RETENTION=90d
# How long a session or agent can stay silent before the app marks it stale, in the same
# units (12h is 12 hours). At least 1h.
CCOBS_SESSION_STALE_AFTER=12h
# Whether the app reads Claude Code's tool_decision events back from Loki, to close
# permission prompts denied with Esc, which fire no hook: true or false.
CCOBS_TELEMETRY_RECONCILE=true
# Loki's HTTP API as the app reaches it inside the stack.
CCOBS_LOKI_URL=http://loki:3100
# Prometheus's HTTP API as the app reaches it inside the stack, for the tokens and cost
# on each session's page.
CCOBS_PROMETHEUS_URL=http://prometheus:9090
# The app's log level: debug, info, warning or error.
CCOBS_LOG_LEVEL=info

# Advanced: the app's hook queue and body limits. A hook that does not fit is dropped,
# still answered with an empty 2xx, and counted in ccobs_hook_events_dropped_total.
# Most hooks the queue holds at once (1 to 1000000).
CCOBS_HOOK_QUEUE_MAX_ITEMS=10000
# Most body bytes the queue holds at once (1 MiB to 1 GiB; 67108864 is 64 MiB).
CCOBS_HOOK_QUEUE_MAX_BYTES=67108864
# Largest hook body read, in bytes (64 KiB to 64 MiB, at most the queue's bytes;
# 8388608 is 8 MiB).
CCOBS_HOOK_BODY_MAX_BYTES=8388608

# Alerts, shown in the browser and, if a webhook is set, sent to Discord. The settings
# screen can override each one; its "Reset" goes back to the value here.
# Waiting on you: a session waiting for an answer or a permission for this many seconds
# (5 to 86400).
CCOBS_ALERT_WAITING_ENABLED=true
CCOBS_ALERT_WAITING_THRESHOLD_S=30
# Repeated failures: this many failed turns (StopFailure, 2 to 100) in one session within
# this many seconds (60 to 86400).
CCOBS_ALERT_FAILURES_ENABLED=true
CCOBS_ALERT_FAILURES_COUNT=3
CCOBS_ALERT_FAILURES_WINDOW_S=600
# Estimated cost of one session, in US dollars (0.01 to 100000); off by default.
CCOBS_ALERT_SESSION_COST_ENABLED=false
CCOBS_ALERT_SESSION_COST_USD=10
# Estimated cost of the last 24 hours, in US dollars (0.01 to 100000); off by default.
CCOBS_ALERT_DAILY_COST_ENABLED=false
CCOBS_ALERT_DAILY_COST_USD=50
# Least time between two alerts of one rule about one session (or the day), in seconds
# (0 to 86400).
CCOBS_ALERT_COOLDOWN_S=300
# Discord: paste the URL from the channel's Integrations > Webhooks > Copy Webhook URL and
# remove the "# ". It is a secret: anyone who has it can post to the channel. Unset, the
# app sends nothing to Discord.
# CCOBS_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/<id>/<token>
# Whether Discord messages name the session's project (true or false). Off by default,
# since the message leaves the machine.
CCOBS_DISCORD_INCLUDE_PROJECT=false
