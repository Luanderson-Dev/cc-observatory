root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,toml,json,html,css,js}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Vendored files and licence texts keep their published bytes (VENDOR.json checksums).
[src/ccobs/server/static/{vendor,licenses}/**]
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
